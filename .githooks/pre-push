#!/bin/sh
# Informational only - never blocks a push (matches this repo's CI policy).
#
# Regenerates vea_sim/tests/gen_sim_tests.rs from tests/*.s and warns if it
# drifted from what is committed, so a push does not leave the generated test
# stale (CI also runs testgen.py, and `generated_is_fresh` guards it there).

root=$(git rev-parse --show-toplevel) || exit 0
gen="vea_sim/tests/gen_sim_tests.rs"

command -v python3 >/dev/null 2>&1 || exit 0

before=$(md5sum "$root/$gen" 2>/dev/null)
( cd "$root/vea_sim" && python3 tests/testgen.py ) || {
    echo "pre-push: testgen.py failed - see output above (push not blocked)." >&2
    exit 0
}
after=$(md5sum "$root/$gen" 2>/dev/null)

if [ "$before" != "$after" ]; then
    echo "pre-push: $gen was out of date - regenerated. Commit it and push again." >&2
fi

exit 0
